#!/usr/bin/env bash
# © Flatra Tech Ltd. All rights reserved.
# Proprietary and confidential. Block commits that lack the copyright header.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "pre-commit: checking copyright headers…"
dart run tool/add_headers.dart --check

echo "pre-commit: checking for secrets in staged content…"
# Fail if anything that looks like a credential is staged. Values are matched,
# never printed.
# Documentation placeholders such as storePassword=<keystore password> are
# allowed, so angle-bracketed tokens are excluded from the match.
if git diff --cached -U0 | grep -E '^\+' | grep -qE 'eyJ[A-Za-z0-9_-]{30,}|sbp_[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|-----BEGIN (RSA|OPENSSH|EC) PRIVATE KEY-----|storePassword=[^<[:space:]]{4,}'; then
  echo "pre-commit: FAIL — a staged file looks like it contains a credential."
  echo "  Inspect with: git diff --cached | grep -E 'eyJ[A-Za-z0-9_-]{30,}|sbp_[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|storePassword='"
  exit 1
fi
if git diff --cached --name-only | grep -qE '(^|/)(\.env|\.env\..*|key\.properties|.*\.(jks|keystore|p12|pem))$'; then
  echo "pre-commit: FAIL — an env or keystore file is staged."
  exit 1
fi

echo "pre-commit: flutter analyze…"
flutter analyze --no-fatal-infos
