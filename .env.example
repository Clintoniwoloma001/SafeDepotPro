# Local tooling credentials. Copy to .env.local and fill in real values.
#
# Used ONLY by the Supabase CLI and psql on this machine for migrations.
# NEVER bundled into the app, NEVER committed, NEVER echoed to logs.
#
# The app itself does not read this file. It reads env/app.json, supplied at
# build time via --dart-define-from-file.
SUPABASE_PROJECT_REF=pgyx
SUPABASE_DB_PASSWORD=replace-with-your-database-password
